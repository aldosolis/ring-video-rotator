{
  "manifest_version": 3,
  "name": "Ring Video Rotator",
  "version": "0.1.0",
  "description": "Adds a button to rotate camera videos on account.ring.com.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Ring Video Rotator",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://account.ring.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "all_frames": true
    }
  ]
}
